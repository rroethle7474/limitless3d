---
/**
 * Prose beside a framed 4:3 photo (`.split`). `rev` puts the art on the left on
 * desktop; under 900px the art always stacks on top. Paragraphs and lists are
 * slotted — their typography is the global `.prose` block, because slotted content
 * can't be reached by scoped styles.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  kicker: string;
  heading: string;
  rev?: boolean;
  image: ImageMetadata;
  alt: string;
}

const { kicker, heading, rev = false, image, alt } = Astro.props;
---

<div class:list={['split', { rev }]}>
  <div class="prose reveal">
    <div class="mono accent">{kicker}</div>
    <h2>{heading}</h2>
    <slot />
  </div>
  <div class="split-art reveal">
    <Image
      class="framed"
      src={image}
      alt={alt}
      widths={[520, 800, 1200]}
      sizes="(max-width: 900px) 92vw, 500px"
      loading="lazy"
    />
  </div>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px;
    align-items: center;
  }

  .split.rev .split-art {
    order: -1;
  }

  .split-art {
    position: relative;
    border-radius: 16px;
    box-shadow: var(--card-shadow);
    background: var(--panel);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .split-art :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .split + .split {
    margin-top: 84px;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .split.rev .split-art {
      order: 0;
    }

    .split-art {
      order: -1;
    }

    .split + .split {
      margin-top: 56px;
    }
  }
</style>
