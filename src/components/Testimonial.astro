---
/**
 * Single-quote band between the build log and the parts shop. Shows the one
 * testimonial flagged "Use in the big quote band" (plan §4.2); the optional
 * highlight phrase gets the accent <em>. Quotes are stored without the
 * surrounding marks — this template adds them.
 */
import { QUOTE_BAND } from '~/data/cms';

const { quote, highlight, attribution } = QUOTE_BAND;
const hlAt = highlight ? quote.indexOf(highlight) : -1;
const before = hlAt >= 0 ? quote.slice(0, hlAt) : quote;
const after = hlAt >= 0 && highlight ? quote.slice(hlAt + highlight.length) : '';
---

<div class="quoteband">
  <div class="wrap reveal">
    <div class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <blockquote>
      &ldquo;{before}{hlAt >= 0 && <em>{highlight}</em>}{after}&rdquo;
    </blockquote>
    <div class="mono">{attribution}</div>
  </div>
</div>

<style>
  .quoteband {
    background: var(--panel);
    border-block: 1px solid var(--line);
    padding: 80px 0;
    text-align: center;
  }

  .quoteband blockquote {
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    font-weight: 500;
    max-width: 44rem;
    margin: 18px auto 20px;
    line-height: 1.4;
  }

  .quoteband blockquote em {
    font-style: normal;
    color: var(--em-a);
  }

  .stars {
    color: var(--em-a);
    letter-spacing: .28em;
    font-size: 1rem;
  }
</style>
