---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import ProofBar from '~/components/ProofBar.astro';
import Section from '~/components/Section.astro';
import SectionHead from '~/components/SectionHead.astro';
import FeatureCards from '~/components/FeatureCards.astro';
import QuoteSection from '~/components/QuoteSection.astro';
import { REVIEWS } from '~/data/cms';
import { ETSY_AGGREGATE, ETSY_ATTRIBUTION, ETSY_RECENT } from '~/data/etsy';
import { SOCIAL } from '~/data/site';

import skiBoot from '~/assets/work/ski-boot.jpg';

const title = 'Customer Reviews | Limitless 3D, Neenah WI';
const description =
  'What customers say about working with Randy at Limitless 3D in Neenah, Wisconsin. Fair pricing, fast responses, and parts that fit.';

/** Where the two "Leave a review" buttons point. Etsy is the shop URL from site.ts. */
const GOOGLE_REVIEW_URL = 'https://www.google.com/search?q=Limitless+3D+Neenah+WI';

/* The hero's numbers follow the live Etsy aggregate so they can never overstate
   (D-045, closing D-040's drift note). "Over N" uses the largest round figure
   strictly below the real count, so the claim stays true the day it renders and
   every day after until the next build. At today's numbers the output is
   byte-identical to the prototype's hardcoded copy. */
const heroRating = ETSY_AGGREGATE.rating.toFixed(1);
const heroCustomers = Math.max(100, Math.floor((ETSY_AGGREGATE.reviewsTotal - 1) / 100) * 100);
const THOUSANDS = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const heroOrdersWord = THOUSANDS[Math.floor((ETSY_AGGREGATE.ordersTotal - 1) / 1000)] ?? '';
const heroOrders = heroOrdersWord
  ? `more than ${heroOrdersWord} thousand orders shipped`
  : `${ETSY_AGGREGATE.ordersTotal.toLocaleString('en-US')} orders shipped`;

/* The cards come from Sanity (every testimonial not flagged for the quote
   band), in editor-set order. Quotes are stored bare; the template re-adds
   the “ ” marks. */

const expectations = [
  {
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
    title: 'A fast, human reply',
    body: 'You will hear back quickly, from the person who will actually do the work.',
  },
  {
    icon: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
    title: 'No smoke and mirrors',
    body: 'If we cannot do something, we say so instead of dragging it out. Your time is money.',
  },
  {
    icon: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/>',
    title: 'Treated like family',
    body: 'This is a small family business. You are not a ticket number in a queue.',
  },
  {
    icon: '<path d="M3 15l12-12 6 6-12 12H3v-6zM8 10l2 2M11 7l2 2"/>',
    title: 'Industrial grade deliverables',
    body: 'Professional results, whether the job is one bracket or a production run.',
  },
];
---

<Base title={title} description={description}>
  <PageHero
    crumb="Reviews"
    heading={`${heroRating} stars from<br />over <em>${heroCustomers}</em> customers.`}
    lead={`Four years on Etsy, ${heroOrders}, and Star Seller recognition for on time delivery and quick replies. The parts speak for themselves.`}
    primary={{ label: 'Get a Quote', href: '/#quote' }}
    ghost={{ label: 'Read all the reviews', href: SOCIAL.etsyShop }}
    image={skiBoot}
    alt="A repaired ski boot with a 3D printed replacement part"
  />

  <ProofBar />

  <Section tint id="fresh">
    <SectionHead
      kicker="Straight from Etsy"
      heading="The latest five-star reviews"
      sub={`Pulled automatically from our Etsy shop — the newest five-star reviews, word for word. The full picture: ${ETSY_AGGREGATE.reviewsTotal} reviews, ${ETSY_AGGREGATE.rating.toFixed(1)} stars average.`}
    />
    <div class="rcards">
      {
        ETSY_RECENT.map((r) => (
          <div class="rcard reveal">
            <span class="stars" role="img" aria-label="Five out of five">★★★★★</span>
            <blockquote>“{r.text}”</blockquote>
            <div class="who">Verified Etsy review · {r.when}</div>
          </div>
        ))
      }
    </div>
    <div class="etsy-more">
      <a class="mono" href={ETSY_AGGREGATE.shopUrl} target="_blank" rel="noopener">
        READ EVERY REVIEW ON ETSY &rarr;
      </a>
    </div>
    <p class="etsy-legal reveal">{ETSY_ATTRIBUTION}</p>
  </Section>

  <Section id="word">
    <SectionHead
      kicker="In their words"
      heading="What customers say"
      sub="Every review here came from a real project. We would rather show you a few true things than a wall of noise."
    />
    <div class="rcards">
      {
        REVIEWS.map((r) => (
          <div class="rcard reveal">
            <span class="stars" role="img" aria-label="Five out of five">★★★★★</span>
            <blockquote>“{r.quote}”</blockquote>
            <div class="who">{r.attribution}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tint>
    <SectionHead
      kicker="Why people come back"
      heading="What you can expect, every time"
      sub="These are our commitments, not customer quotes. Hold us to them."
    />
    <FeatureCards cards={expectations} two />
  </Section>

  <Section narrow>
    <div class="leave reveal">
      <div class="mono accent">Worked with us?</div>
      <h2>Leave a review</h2>
      <p>
        It genuinely helps a small shop, and it helps the next person decide. A sentence is
        plenty.
      </p>
      <div class="leave-ctas">
        <a class="btn primary" href={SOCIAL.etsyShop} target="_blank" rel="noopener">
          Leave a review on Etsy
        </a>
        <a class="btn ghost" href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener">
          Review us on Google
        </a>
      </div>
    </div>
  </Section>

  <QuoteSection />
</Base>

<style>
  /* ---- review cards (`.rcards`) — only this page uses them ---- */
  .rcards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .rcard {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
    box-shadow: var(--card-shadow);
    text-align: center;
  }

  .rcard .stars {
    display: block;
    color: var(--em-a);
    letter-spacing: .28em;
    font-size: .85rem;
    margin-bottom: 14px;
  }

  .rcard blockquote {
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .rcard .who {
    font-family: var(--font-mono);
    font-size: .66rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (max-width: 820px) {
    .rcards {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Etsy strip extras (the cards themselves are `.rcards`) ----
     The link echoes ProofBar's `.proof-link`; the legal line is the
     attribution Etsy's API Terms require, verbatim from etsy.ts. */
  .etsy-more {
    text-align: center;
    margin-top: 26px;
  }

  .etsy-more a {
    color: var(--muted);
    font-size: .68rem;
  }

  .etsy-more a:hover {
    color: var(--em-a);
  }

  .etsy-legal {
    text-align: center;
    color: var(--faint);
    font-size: .72rem;
    margin-top: 14px;
  }

  /* ---- leave a review ----
     The prototype styles this block inline; the values are its own. The CTA row is the
     prototype's `.hero-ctas` rule, centred — including its 38px trailing margin. */
  .leave {
    text-align: center;
  }

  .leave h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    margin: 14px 0 14px;
  }

  .leave p {
    color: var(--muted);
    margin-bottom: 28px;
  }

  .leave-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 38px;
  }
</style>
