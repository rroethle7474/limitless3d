# Local secrets for `npx wrangler pages dev dist` — copy to `.dev.vars` (gitignored) and
# fill in the real values. In production these become Cloudflare Pages env vars/secrets.

# Resend API key (https://resend.com/api-keys). Test mode sends from onboarding@resend.dev
# and only delivers to the account owner's own address.
RESEND_API_KEY=re_PASTE_KEY_HERE

# Where quote submissions are delivered. Ryan's inbox during Phase 1b; the production
# address is open question §9.4 in the plan.
QUOTE_TO_EMAIL=rroethle@gmail.com

# Cloudflare Turnstile secret. The official "always passes" TEST secret below is safe to
# commit and useless in production; the REAL secret (Cloudflare dashboard → Turnstile →
# widget "limitless3d") replaced it in .dev.vars + Pages env on 2026-08-13. Pair: the real
# SITE key lives in .env as PUBLIC_TURNSTILE_SITE_KEY (build-time, public — inlined into
# the HTML); without it the code falls back to the visible test widget.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sanity write token (sanity.io/manage → project → API → Tokens → Editor permissions).
# The §3b dual-write's storage half (D-027): each submission is also stored as a private
# draft document. If unset, the function logs a warning and the email is the only record —
# storage must never block the email path.
SANITY_API_TOKEN=sk_PASTE_TOKEN_HERE

# Square catalog (plan §10 2026-08-11: demo runs on Ryan's SANDBOX seeded with the live
# shop's public product data; cutover swaps these three values to Randy's production
# credentials). Token: developer.squareup.com → application → Credentials → Sandbox
# Access Token. Used by scripts/shop/seed.mjs and the /parts build-time fetch.
# SQUARE_LOCATION_ID is filled from ListLocations after the token lands — don't guess it.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAA_PASTE_SANDBOX_TOKEN_HERE
SQUARE_LOCATION_ID=

# Etsy reviews (D-039/D-040). Key + shared secret from etsy.com/developers/your-apps
# (Ryan's personal app "limitless-3d"; new keys need manual Etsy approval before they
# work). The x-api-key header is "keystring:shared_secret" — the keystring alone 403s.
# ETSY_SOURCE=fixture builds from the committed verbatim fixture (no network, no key
# needed); "live" pages the full review set from the Open API at build time.
ETSY_API_KEY=PASTE_KEYSTRING_HERE
ETSY_SHARED_SECRET=PASTE_SHARED_SECRET_HERE
ETSY_SHOP_ID=26921666
ETSY_SOURCE=fixture
